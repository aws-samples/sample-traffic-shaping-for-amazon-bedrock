# Semaphore Rate Limiter Configuration
# This file is auto-generated by deploy.sh after CDK deployment
# Copy this to config.env and fill in your values, or run make setup

# AWS Configuration
AWS_REGION=us-east-1

# Step Functions
STATE_MACHINE_ARN=arn:aws:states:REGION:ACCOUNT:stateMachine:NAME

# DynamoDB Table
SINGLE_TABLE_NAME=semaphore-single-table

# Lambda Functions (ARNs for configuration updates)
BUDGET_MANAGER_ARN=arn:aws:lambda:REGION:ACCOUNT:function:NAME
QUEUE_PROCESSOR_ARN=arn:aws:lambda:REGION:ACCOUNT:function:NAME
FOUNDATION_MODEL_ARN=arn:aws:lambda:REGION:ACCOUNT:function:NAME

# CloudWatch Log Groups (for viewing logs)
BUDGET_MANAGER_LOG_GROUP=/aws/lambda/FUNCTION_NAME
QUEUE_PROCESSOR_LOG_GROUP=/aws/lambda/FUNCTION_NAME
BEDROCK_PROCESSOR_LOG_GROUP=/aws/lambda/FUNCTION_NAME

# Edge Layer (API Gateway + regional WAF)
API_GATEWAY_URL=https://XXXXXXXXXX.execute-api.REGION.amazonaws.com/prod/
WAF_WEB_ACL_ARN=arn:aws:wafv2:REGION:ACCOUNT:regional/webacl/NAME/ID

# Dead Letter Queue
DLQ_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/QUEUE_NAME
DLQ_ARN=arn:aws:sqs:REGION:ACCOUNT:QUEUE_NAME

# Observability
DASHBOARD_URL=https://REGION.console.aws.amazon.com/cloudwatch/home?region=REGION#dashboards/dashboard/NAME

# Testing Configuration
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
NUM_REQUESTS=125
MAX_WORKERS=10
SUBMISSION_DURATION=10
