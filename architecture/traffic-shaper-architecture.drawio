<mxfile host="app.diagrams.net" agent="pai" version="24.7.7" type="device">
  <diagram id="bedrock-traffic-shaper" name="Traffic Shaper Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Amazon Bedrock Traffic Shaper — Distributed Semaphore Rate Limiter" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="18" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Regional WAF → API Gateway (IAM auth) → Step Functions (waitForTaskToken). Over-quota requests are queued (never rejected) and drained as capacity regenerates. Default capacity split 0% burst / 85% queue / 15% buffer (queue-only). Honest 200 / 429 / 503 outcomes via GET /result." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#5A6C7D;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="1560" height="24" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDING BOXES (drawn first = behind) ==================== -->

        <!-- AWS Cloud -->
        <mxCell id="awscloud" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=0;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grpIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="170" y="100" width="1900" height="1080" as="geometry" />
