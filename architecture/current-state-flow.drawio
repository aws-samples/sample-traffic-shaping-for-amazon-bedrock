<mxCell id="title" value="Amazon Bedrock Traffic Shaper — Current-State Request Flow" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="18" width="1000" height="30" as="geometry" /></mxCell>
<mxCell id="sub" value="Validated against the deployed stack. Every over-quota request is queued (never rejected) and resolves to exactly one honest terminal outcome, read via GET /result." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#5A6C7D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="48" width="1100" height="20" as="geometry" /></mxCell>

<mxCell id="start" value="Client — POST /invoke (SigV4 / IAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#ffffff;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="240" height="44" as="geometry" /></mxCell>
<mxCell id="ingress" value="AWS WAF (regional) → API Gateway&#10;AwsIntegration → StartExecution&#10;(HTTP 200 = execution started)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0F7;strokeColor=#E7157B;fontColor=#A00E56;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="240" height="60" as="geometry" /></mxCell>
<mxCell id="sfn" value="Step Functions — ReserveBudget&#10;(waitForTaskToken · 65-min timeout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FE;strokeColor=#4D72F3;fontColor=#1B3A9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="256" width="240" height="56" as="geometry" /></mxCell>
<mxCell id="budget" value="Budget Manager&#10;validate input + estimate tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="348" width="240" height="52" as="geometry" /></mxCell>
<mxCell id="d1a" value="input valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#B0233A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="430" width="160" height="80" as="geometry" /></mxCell>
<mxCell id="adread" value="Sliding-window admission read&#10;(2 s rate + 15 s accuracy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="548" width="240" height="52" as="geometry" /></mxCell>
<mxCell id="d1" value="under budget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#B0233A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="516" y="636" width="168" height="92" as="geometry" /></mxCell>
<mxCell id="immediate" value="Write consumption estimate →&#10;async-invoke Bedrock Processor&#10;(source: immediate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="770" width="240" height="64" as="geometry" /></mxCell>

<mxCell id="qitems" value="DynamoDB QUEUE#ITEMS&#10;write QUEUED · trigger EventBridge" style="shape=cylinder3;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FBEFFC;strokeColor=#C925D1;fontColor=#8C1F91;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="632" width="200" height="80" as="geometry" /></mxCell>
<mxCell id="qproc" value="Queue Processor — drain loop&#10;(single-owner · paced gates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="748" width="200" height="56" as="geometry" /></mxCell>
<mxCell id="d2" value="item expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#B0233A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="844" width="140" height="76" as="geometry" /></mxCell>
<mxCell id="qinvoke" value="Invoke Bedrock Processor&#10;(source: queued)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="964" width="200" height="52" as="geometry" /></mxCell>

<mxCell id="bproc" value="Bedrock Processor&#10;resolve payload · call Bedrock&#10;(boto3 retries disabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="900" width="240" height="64" as="geometry" /></mxCell>
<mxCell id="d4" value="Bedrock result?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#B0233A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="516" y="1010" width="168" height="92" as="geometry" /></mxCell>
<mxCell id="success" value="Reconcile tokens → write S3 body →&#10;write SUCCEEDED STATUS (output_ref)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF4;strokeColor=#7AA116;fontColor=#4C6B0E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1146" width="300" height="60" as="geometry" /></mxCell>
<mxCell id="d4a" value="STATUS + S3 write ok?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#B0233A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="516" y="1252" width="168" height="84" as="geometry" /></mxCell>
<mxCell id="callback" value="SendTaskSuccess → SFN Success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FE;strokeColor=#4D72F3;fontColor=#1B3A9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1380" width="240" height="46" as="geometry" /></mxCell>
<mxCell id="finalizer" value="SFN TimedOut (65-min) or token&#10;never resumes → EventBridge →&#10;Finalizer writes terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FE;strokeColor=#4D72F3;fontColor=#1B3A9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="895" y="1250" width="210" height="70" as="geometry" /></mxCell>
<mxCell id="resultpoll" value="Client polls GET /result/{request_id}&#10;Result Lambda maps terminal STATUS → HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#263238;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="1470" width="300" height="56" as="geometry" /></mxCell>

<mxCell id="outcome" value="DynamoDB Stream → OutcomeStream&#10;→ EMF RequestOutcome metric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6EF;strokeColor=#ED7100;fontColor=#B25900;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="1146" width="250" height="56" as="geometry" /></mxCell>
