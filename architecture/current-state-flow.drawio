<mxCell id="t202" value="HTTP 202 — queued / pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EEFD;strokeColor=#1565C0;fontColor=#0D3C78;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="644" width="200" height="46" as="geometry" /></mxCell>
<mxCell id="t504" value="HTTP 504 — timeout / queue_expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDED;strokeColor=#8B5A5A;fontColor=#5C3A3A;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="936" width="200" height="46" as="geometry" /></mxCell>
<mxCell id="t429" value="HTTP 429 — throttled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B25900;fontColor=#8A4500;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1024" width="200" height="46" as="geometry" /></mxCell>
<mxCell id="t503" value="HTTP 503 — capacity / backend error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;fontColor=#8C271C;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1112" width="200" height="46" as="geometry" /></mxCell>
<mxCell id="t200" value="HTTP 200 — success (presigned S3 URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5E8;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1380" width="200" height="46" as="geometry" /></mxCell>

<mxCell id="note" value="Validated against the current code (differs from the legacy current/future-state diagrams): no CloudFront edge; a sliding-window admission read replaces the old counter gate; a single-state Step Functions machine (ReserveBudget → Success) with the Bedrock Processor as an async Lambda; the queued path writes QUEUED / 202 and holds the task token (no execution resume at enqueue) until the drained call sends the single callback; the scheduled Reconciliation Lambda was removed (60 s TTL + inline expiry)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C9B458;fontColor=#5C4E00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=16;" vertex="1" parent="1"><mxGeometry x="360" y="1580" width="820" height="120" as="geometry" /></mxCell>

